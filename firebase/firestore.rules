rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /transactions/{transactionId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null
        && (resource.data.userId == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Temporary: used by FirestoreTestPage to verify connectivity.
    // Remove this match block along with lib/firestore_test_page.dart once confirmed.
    match /connection_test/{docId} {
      allow read, write: if request.auth != null;
    }

  }
}